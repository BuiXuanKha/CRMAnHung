generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Image/attachment fields use objectKey = Cloudflare R2 object key (ADR 0005).

/// Nhân viên / admin
model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  phone        String?
  passwordHash String
  role         String   @default("STAFF") // STAFF | ADMIN
  /// Public R2 key — CDN avatar NV (quản lý `/quan-tri/nguoi-dung`).
  avatarObjectKey String?
  isActive     Boolean  @default(true)
  /// Bumped to invalidate outstanding access JWTs (disable / role / password reset).
  sessionVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens     RefreshToken[]
  customers         Customer[]             @relation("CustomerOwner")
  customerPhones    CustomerPhone[]
  facebookProfiles  EmployeeFacebookProfile[]
  hotlines          EmployeeHotline[]
  careNotes         CustomerCareNote[]
  createdProvinces  Province[]             @relation("ProvinceCreator")
  createdDistricts  District[]             @relation("DistrictCreator")
  createdWards      Ward[]                 @relation("WardCreator")
  createdAddresses  Address[]              @relation("AddressCreator")
  createdProjectLots ProjectLot[]          @relation("ProjectLotCreator")
  createdLodats     Lodat[]                @relation("LodatCreator")
  createdLodatMaps  LodatCustomerMap[]     @relation("LodatMapCreator")
  createdTransactions Transaction[]        @relation("TransactionCreator")
  createdTitleServices TitleService[]      @relation("TitleServiceCreator")
  createdTitleServiceProgress TitleServiceProgress[] @relation("TitleServiceProgressCreator")
  createdTitleServiceMoney TitleServiceMoney[] @relation("TitleServiceMoneyCreator")
  createdTitleServiceAttachments TitleServiceAttachment[] @relation("TitleServiceAttachmentCreator")
  viewedTitleServiceAttachments TitleServiceAttachmentView[] @relation("TitleServiceAttachmentViewer")
  publicLotShares           PublicLotShare[]
  publicShareViewStat       PublicShareViewStat?
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Khách hàng (tương đương tblPerson)
model Customer {
  id              String   @id @default(cuid())
  employeeId      String
  fullName        String
  status          String   @default("KHACH_MOI")
  budgetMinVnd    BigInt?
  budgetMaxVnd    BigInt?
  isPinned        Boolean  @default(false)
  isHidden        Boolean  @default(false)
  pinnedAt        DateTime?
  autoRestoredAt  DateTime?
  sourceHotlineId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee      User                   @relation("CustomerOwner", fields: [employeeId], references: [id])
  sourceHotline EmployeeHotline?       @relation(fields: [sourceHotlineId], references: [id])
  facebook      CustomerFacebook?
  phones        CustomerPhone[]
  careNotes     CustomerCareNote[]
  lodatMaps     LodatCustomerMap[]
  transactionParties TransactionParty[]
  titleServices TitleService[]

  @@index([employeeId])
  @@index([status])
  @@index([isHidden])
}

model CustomerFacebook {
  id                  String   @id @default(cuid())
  customerId          String   @unique
  customerUid         String?
  threadId            String?
  facebookName        String?
  avatarUrl           String?
  scanSource          String?
  scanSourceLabel     String?
  employeeFacebookUid String?
  avatarObjectKey     String?
  rawMeta             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages CustomerMessengerMessage[]

  @@index([customerUid])
  @@index([threadId])
  @@index([employeeFacebookUid])
}

model CustomerPhone {
  id         String   @id @default(cuid())
  customerId String
  /// Denormalized from Customer — enforces one Person per SĐT per NV (BUG-018).
  employeeId String
  phone      String
  label      String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  employee User     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([customerId, phone])
  @@unique([employeeId, phone])
  @@index([customerId])
  @@index([phone])
  @@index([employeeId])
}

model CustomerMessengerMessage {
  id                 String   @id @default(cuid())
  customerFacebookId String
  externalMessageId  String?
  body               String?
  sender             String?
  senderUid          String?
  dedupeKey          String?
  sortOrder          Int      @default(0)
  direction          String?
  sentAt             DateTime?
  createdAt          DateTime @default(now())

  customerFacebook CustomerFacebook          @relation(fields: [customerFacebookId], references: [id], onDelete: Cascade)
  images           CustomerMessengerImage[]

  @@index([customerFacebookId])
  @@index([customerFacebookId, sortOrder])
}

model CustomerMessengerImage {
  id           String   @id @default(cuid())
  messageId    String
  objectKey    String
  originalPath String?
  sortOrder    Int      @default(0)
  rotationDeg  Int      @default(0)
  createdAt    DateTime @default(now())

  message CustomerMessengerMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, sortOrder])
}

model CustomerCareNote {
  id          String   @id @default(cuid())
  customerId  String
  employeeId  String
  needSummary String?
  note        String   @default("")
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  employee User     @relation(fields: [employeeId], references: [id])

  @@index([customerId])
  @@index([customerId, createdAt])
}

model EmployeeFacebookProfile {
  id          String   @id @default(cuid())
  employeeId  String
  facebookUid String
  nickname    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, facebookUid])
  @@index([facebookUid])
}

model EmployeeHotline {
  id         String   @id @default(cuid())
  employeeId String
  phone      String
  label      String
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee  User       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@unique([employeeId, phone])
  @@index([employeeId])
}

/// Đơn vị hành chính — copy từ tblAddr* (theo tên, không dùng mã nhà nước).
model Province {
  id                  String   @id @default(cuid())
  name                String
  isHidden            Boolean  @default(false)
  createdByEmployeeId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  districts District[]
  addresses Address[]
  createdBy User?      @relation("ProvinceCreator", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  @@index([isHidden])
}

model District {
  id                  String   @id @default(cuid())
  provinceId          String
  name                String
  isHidden            Boolean  @default(false)
  createdByEmployeeId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  wards     Ward[]
  addresses Address[]
  province  Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("DistrictCreator", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  @@index([provinceId])
  @@index([isHidden])
}

model Ward {
  id                  String   @id @default(cuid())
  districtId          String
  name                String
  isHidden            Boolean  @default(false)
  createdByEmployeeId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  addresses  Address[]
  communeHub PublicCommuneHub?
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  createdBy  User?    @relation("WardCreator", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  @@index([districtId])
  @@index([isHidden])
}

/// Sổ địa chỉ dùng chung. REGULAR = đất dân; PROJECT = dự án (có ảnh).
model Address {
  id                  String   @id @default(cuid())
  kind                String   @default("REGULAR") // REGULAR | PROJECT
  detail              String?
  description         String?
  provinceId          String
  districtId          String
  wardId              String
  isHidden            Boolean  @default(false)
  createdByEmployeeId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  province  Province       @relation(fields: [provinceId], references: [id])
  district  District       @relation(fields: [districtId], references: [id])
  ward      Ward           @relation(fields: [wardId], references: [id])
  createdBy User?          @relation("AddressCreator", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  lodats      Lodat[]
  projectLots ProjectLot[]
  images      AddressImage[]

  @@index([kind])
  @@index([provinceId])
  @@index([districtId])
  @@index([wardId])
  @@index([isHidden])
}

model AddressImage {
  id        String   @id @default(cuid())
  addressId String
  objectKey String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  address Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@index([addressId, sortOrder])
}

/// Kho lô dự án — Admin import/sửa. STAFF chỉ trỏ qua Lodat.projectLotId.
model ProjectLot {
  id                  String   @id @default(cuid())
  addressId           String
  title               String
  areaM2              Float?
  frontageM           Float?
  direction           String?
  note                String?
  isHidden            Boolean  @default(false)
  createdByEmployeeId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("ProjectLotCreator", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  lodats    Lodat[]

  @@index([addressId])
  @@index([isHidden])
  @@index([title])
}

/// Lô trên /lo-dat: dân (addressId + DT/MT) hoặc dự án (projectLotId trỏ kho).
model Lodat {
  id                  String   @id @default(cuid())
  /// REGULAR: tiêu đề NV đặt. PROJECT: null — đọc từ ProjectLot.title
  title               String?
  areaM2              Float?
  frontageM           Float?
  direction           String?
  note                String?
  /// REGULAR: bắt buộc. PROJECT: null (địa chỉ qua ProjectLot)
  addressId           String?
  /// PROJECT: bắt buộc. REGULAR: null
  projectLotId        String?
  /// Hangtag Nhà/Đất (web mới) — mặc định DAT khi copy
  propertyKind        String   @default("DAT") // NHA | DAT
  createdByEmployeeId String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  address    Address?           @relation(fields: [addressId], references: [id], onDelete: Restrict)
  projectLot ProjectLot?        @relation(fields: [projectLotId], references: [id], onDelete: Restrict)
  createdBy  User               @relation("LodatCreator", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  images         LodatImage[]
  maps           LodatCustomerMap[]
  transactions   Transaction[]
  publicListing  PublicLotListing?

  @@index([addressId])
  @@index([projectLotId])
  @@index([createdByEmployeeId])
  @@index([propertyKind])
}

/// Copy public anhungland.com — không chứa PII / giá CRM / hoa hồng.
model PublicLotListing {
  id              String   @id @default(cuid())
  lodatId         String   @unique
  slug            String   @unique
  title           String
  /// SEO document title (GPT seoTitle) — on-page H1 uses `title` (GPT h1).
  seoTitle        String?
  location        String   @default("")
  isPublished     Boolean  @default(false)
  /// AMOUNT | CONTACT
  priceMode       String   @default("CONTACT")
  priceLabel      String?
  excerpt         String   @default("")
  /// TipTap HTML — mô tả công khai (ảnh = URL CDN).
  bodyHtml        String   @default("")
  metaDescription String?
  /// Lần đăng web đầu tiên (giữ khi gỡ).
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lodat Lodat @relation(fields: [lodatId], references: [id], onDelete: Cascade)
  shares PublicLotShare[]

  @@index([isPublished])
  @@index([updatedAt])
}

/// Link share lô public — một mã / (nhân viên + listing đã publish).
model PublicLotShare {
  id              String   @id @default(cuid())
  shareCode       String   @unique
  employeeId      String
  publicListingId String
  visitCount      Int      @default(0)
  createdAt       DateTime @default(now())

  employee      User             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  publicListing PublicLotListing @relation(fields: [publicListingId], references: [id], onDelete: Cascade)

  @@unique([employeeId, publicListingId])
  @@index([publicListingId])
}

/// Lượt xem trang khách gắn cookie share — cộng mỗi lần tải/đổi trang (kể cả F5).
model PublicShareViewStat {
  employeeId String   @id
  viewCount  Int      @default(0)
  updatedAt  DateTime @updatedAt

  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

/// Lượt xem khách không cookie share (dòng Truy cập trực tiếp). Singleton `id = direct`.
model PublicDirectViewStat {
  id        String   @id
  viewCount Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// 301 slug lô cũ → slug mới (sau khi đổi công thức tên+địa chỉ).
model PublicLotSlugRedirect {
  id        String   @id @default(cuid())
  fromSlug  String   @unique
  toSlug    String
  createdAt DateTime @default(now())

  @@index([toSlug])
}

/// Trang hub xã cố định (`/xa/{slug}`). Không xóa khi hết lô đang bán.
model PublicCommuneHub {
  id            String   @id @default(cuid())
  wardId        String   @unique
  slug          String   @unique
  label         String
  districtLabel String   @default("")
  provinceLabel String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ward Ward @relation(fields: [wardId], references: [id], onDelete: Restrict)

  @@index([updatedAt])
}

/// 301 slug xã cũ → slug hiện tại (đổi tên xã).
model PublicCommuneHubRedirect {
  id        String   @id @default(cuid())
  fromSlug  String   @unique
  toSlug    String
  createdAt DateTime @default(now())

  @@index([toSlug])
}

/// Bài CMS web công khai (tin / dự án / kiến thức…).
model PublicPost {
  id              String    @id @default(cuid())
  slug            String
  /// tin-tuc | du-an | kien-thuc | kinh-nghiem | lien-he | chinh-sach
  category        String
  /// DRAFT | PUBLISHED
  status          String    @default("DRAFT")
  title           String
  coverImageUrl   String?
  bodyHtml        String    @default("")
  excerpt         String    @default("")
  metaDescription String?
  authorLabel     String    @default("An Hưng Land")
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([category, slug])
  @@index([status])
  @@index([category, status])
  @@index([updatedAt])
}

model LodatImage {
  id          String   @id @default(cuid())
  lodatId     String
  objectKey   String
  sortOrder   Int      @default(0)
  rotationDeg Int      @default(0)
  createdAt   DateTime @default(now())

  lodat Lodat @relation(fields: [lodatId], references: [id], onDelete: Cascade)
  snapshotImages TransactionSnapshotImage[]

  @@index([lodatId, sortOrder])
}

model LodatTempImage {
  id        String   @id @default(cuid())
  sessionId String
  objectKey String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

/// Map NV–khách–lô: giá, mở bán, lịch sử chủ (isActive / endedAt).
/// 1 chủ active / lodat: unique index SQL `LodatCustomerMap_lodatId_active_uidx` (BUG-020).
model LodatCustomerMap {
  id                  String    @id @default(cuid())
  lodatId             String
  customerId          String
  priceVnd            BigInt?
  priceNote           String?
  brokerFeeNote       String?
  status              String    @default("TAM_DUNG") // DANG_BAN | TAM_DUNG | DAT_COC | DA_BAN
  note                String?
  isActive            Boolean   @default(true)
  endedAt             DateTime?
  createdByEmployeeId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  lodat     Lodat     @relation(fields: [lodatId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("LodatMapCreator", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([lodatId, isActive])
  @@index([customerId])
  @@index([createdByEmployeeId])
  @@index([status])
}

/// Giao dịch mua bán lô — khớp tblTransaction (CRM cũ). Tiền BIGINT.
/// 1 GD mở (DA_COC | DA_CONG_CHUNG) / lodat: unique index SQL (không khai báo trong Prisma).
model Transaction {
  id                  String    @id @default(cuid())
  code                String    @unique
  lodatId             String
  lodatCustomerMapId  String
  type                String    @default("OWN") // OWN | RECORD
  status              String    @default("DA_COC") // DA_COC | DA_CONG_CHUNG | HOAN_TAT | HUY
  notaryAppointmentAt DateTime?
  salePriceVnd        BigInt    @default(0)
  taxPriceVnd         BigInt?
  commissionVnd       BigInt    @default(0)
  note                String?
  cancelReason        String?
  createdByEmployeeId String
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  lodat            Lodat                   @relation(fields: [lodatId], references: [id], onDelete: Restrict)
  lodatCustomerMap LodatCustomerMap        @relation(fields: [lodatCustomerMapId], references: [id], onDelete: Restrict)
  createdBy        User                    @relation("TransactionCreator", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  parties          TransactionParty[]
  attachments      TransactionAttachment[]
  snapshot         TransactionSnapshot?

  @@index([lodatId])
  @@index([lodatCustomerMapId])
  @@index([createdByEmployeeId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model TransactionParty {
  id            String  @id @default(cuid())
  transactionId String
  role          String // SELLER | BUYER
  customerId    String?
  /// Tên lúc tạo GD — luôn ghi, kể cả khi có customerId
  freeTextName  String
  sortOrder     Int     @default(0)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([transactionId, role, sortOrder])
  @@index([customerId])
}

/// Đóng băng tiêu đề / địa chỉ / DT·MT / giá map lúc tạo GD (tblTransactionSnapshot).
model TransactionSnapshot {
  id               String   @id @default(cuid())
  transactionId    String   @unique
  title            String?
  addressText      String?
  areaM2           Float?
  frontageM        Float?
  direction        String?
  propertyKind     String? // NHA | DAT
  mapStatus        String?
  mapPriceVnd      BigInt?
  mapPriceNote     String?
  mapBrokerFeeNote String?
  mapNote          String?
  createdAt        DateTime @default(now())

  transaction Transaction                @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  images      TransactionSnapshotImage[]
}

model TransactionSnapshotImage {
  id                 String @id @default(cuid())
  snapshotId         String
  objectKey          String
  sortOrder          Int    @default(0)
  rotationDeg        Int    @default(0)
  sourceLodatImageId String?

  snapshot         TransactionSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  sourceLodatImage LodatImage?         @relation(fields: [sourceLodatImageId], references: [id], onDelete: SetNull)

  @@index([snapshotId, sortOrder])
}

model TransactionAttachment {
  id            String   @id @default(cuid())
  transactionId String
  objectKey     String
  kind          String   @default("KHAC") // HOP_DONG | SO_DO | KHAC
  label         String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, sortOrder])
}

/// Hồ sơ làm sổ đỏ — khớp tblTitleService (CRM cũ). Tiền BIGINT. File = private R2.
model TitleService {
  id                  String    @id @default(cuid())
  code                String    @unique
  customerId          String
  status              String    @default("DANG_LAM") // DANG_LAM | TAM_DUNG | HOAN_THANH | HUY
  agreedFeeVnd        BigInt?
  needSummary         String?
  note                String?
  startedAt           DateTime
  expectedDoneAt      DateTime?
  completedAt         DateTime?
  createdByEmployeeId String
  isPinned            Boolean   @default(false)
  pinnedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer     Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User                      @relation("TitleServiceCreator", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  progress     TitleServiceProgress[]
  moneyEntries TitleServiceMoney[]
  attachments  TitleServiceAttachment[]

  @@index([customerId])
  @@index([createdByEmployeeId])
  @@index([status])
  @@index([isPinned, pinnedAt])
  @@index([updatedAt])
}

model TitleServiceProgress {
  id                  String   @id @default(cuid())
  titleServiceId      String
  stepType            String // BAN_GIA | THU_THAP_GIAY_TO | DO_DAC | NOP_HO_SO | BO_SUNG | LAM_VIEC_CO_QUAN | NHAN_KET_QUA | BAN_GIAO | KHAC
  note                String?
  happenedAt          DateTime
  createdByEmployeeId String
  createdAt           DateTime @default(now())

  titleService TitleService @relation(fields: [titleServiceId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TitleServiceProgressCreator", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)

  @@index([titleServiceId, happenedAt])
  @@index([createdByEmployeeId])
}

model TitleServiceMoney {
  id                  String   @id @default(cuid())
  titleServiceId      String
  kind                String // THU | CHI
  title               String
  amountVnd           BigInt
  note                String?
  happenedAt          DateTime
  createdByEmployeeId String
  createdAt           DateTime @default(now())

  titleService TitleService @relation(fields: [titleServiceId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TitleServiceMoneyCreator", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)

  @@index([titleServiceId, happenedAt])
  @@index([createdByEmployeeId])
}

/// Giấy tờ mật — objectKey chỉ private R2 (không CDN / không URL tĩnh).
model TitleServiceAttachment {
  id                  String   @id @default(cuid())
  titleServiceId      String
  kind                String // SO_DO | CAN_CUOC | KHAC
  fileName            String
  objectKey           String
  createdByEmployeeId String
  createdAt           DateTime @default(now())

  titleService TitleService @relation(fields: [titleServiceId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TitleServiceAttachmentCreator", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  views        TitleServiceAttachmentView[]

  @@unique([objectKey])
  @@index([titleServiceId])
  @@index([createdByEmployeeId])
}

/// Nhật ký xem giấy tờ mật — ghi khi cấp signed URL.
model TitleServiceAttachmentView {
  id                 String   @id @default(cuid())
  attachmentId       String
  viewedByEmployeeId String
  viewedAt           DateTime @default(now())

  attachment TitleServiceAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  viewedBy   User                   @relation("TitleServiceAttachmentViewer", fields: [viewedByEmployeeId], references: [id], onDelete: Restrict)

  @@index([attachmentId, viewedAt])
  @@index([viewedByEmployeeId])
}

model ImageRotation {
  id        String   @id @default(cuid())
  objectKey  String   @unique
  degrees   Int      @default(0)
  updatedAt DateTime @updatedAt
}
