# Server
PORT=5050
HOST=0.0.0.0
NODE_ENV=development

# Database — PostgreSQL (docker compose: pnpm db:up)
DATABASE_URL="postgresql://crmanhung:crmanhung@127.0.0.1:5432/crmanhung?schema=public"

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# Cloudflare R2 (S3-compatible) — bắt buộc cho upload; có thể dùng bucket dev riêng
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=crmanhung-dev
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
