# Server
PORT=5050
HOST=0.0.0.0
NODE_ENV=development

# Database — PostgreSQL (docker compose: pnpm db:up)
DATABASE_URL="postgresql://crmanhung:crmanhung@127.0.0.1:5432/crmanhung?schema=public"

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# Cloudflare R2 — bucket An Hưng Land (APAC)
# S3 API (console): https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<bucket>
R2_ACCOUNT_ID=271dac0fb7f61cb74a3d5427b93661bc
R2_BUCKET=anhungland-crm
R2_ENDPOINT=https://271dac0fb7f61cb74a3d5427b93661bc.r2.cloudflarestorage.com
# Keys: Cloudflare → R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public URL — CDN custom domain (bucket anhungland-crm)
R2_PUBLIC_BASE_URL=https://cdn.anhungland.com
# Tài liệu mật — bucket riêng; KHÔNG Enable public URL; KHÔNG Connect Domain
R2_PRIVATE_BUCKET=anhungland-crm-private

# On-demand ISR — cùng secret với apps/web; Nest gọi Next qua loopback (không dùng cho link share khách)
REVALIDATE_SECRET=change-me-revalidate-secret-min-32-chars!!
PUBLIC_WEB_ORIGIN=http://127.0.0.1:5001
# URL share / canonical khách — mặc định https://anhungland.com (không trộn với PUBLIC_WEB_ORIGIN)
# PUBLIC_SITE_ORIGIN=https://anhungland.com

# OpenAI — GPT soạn bài đăng lô (ADMIN /dashboard/lo-dat). Không commit key thật.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
