NEXT_PUBLIC_API_URL=http://localhost:5050/api/v1
# true = list lô / giao dịch / sổ đỏ dùng mock khi chưa có API domain
NEXT_PUBLIC_USE_MOCK=true
# true = login giả staff/admin123. false = /login gọi API + bảng User
# List /khach-hang theo login: login thật → API khách đã copy
NEXT_PUBLIC_USE_MOCK_AUTH=true
# On-demand ISR — cùng giá trị với apps/api REVALIDATE_SECRET
REVALIDATE_SECRET=change-me-revalidate-secret-min-32-chars!!
