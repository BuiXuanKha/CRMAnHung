{
  "name": "crmanhung",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @crmanhung/api --filter @crmanhung/web run dev",
    "dev:api": "pnpm --filter @crmanhung/api dev",
    "dev:web": "pnpm --filter @crmanhung/web dev",
    "dev:extension": "pnpm --filter @crmanhung/extension dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @crmanhung/api db:generate",
    "db:migrate": "pnpm --filter @crmanhung/api db:migrate",
    "db:seed": "pnpm --filter @crmanhung/api db:seed",
    "users:migrate-legacy": "pnpm --filter @crmanhung/api users:migrate-legacy",
    "phones:migrate-legacy": "pnpm --filter @crmanhung/api phones:migrate-legacy",
    "care:migrate-legacy": "pnpm --filter @crmanhung/api care:migrate-legacy",
    "chat:migrate-legacy": "pnpm --filter @crmanhung/api chat:migrate-legacy",
    "lodats:migrate-legacy": "pnpm --filter @crmanhung/api lodats:migrate-legacy",
    "lots:regenerate-public-slugs": "pnpm --filter @crmanhung/api lots:regenerate-public-slugs",
    "images:seo-copy": "pnpm --filter @crmanhung/api images:seo-copy",
    "images:seo-copy-addresses": "pnpm --filter @crmanhung/api images:seo-copy-addresses",
    "images:seo-copy-posts": "pnpm --filter @crmanhung/api images:seo-copy-posts",
    "images:webp-public-media": "pnpm --filter @crmanhung/api images:webp-public-media",
    "images:webp-replace": "pnpm --filter @crmanhung/api images:webp-replace",
    "transactions:migrate-legacy": "pnpm --filter @crmanhung/api transactions:migrate-legacy",
    "title-services:migrate-legacy": "pnpm --filter @crmanhung/api title-services:migrate-legacy",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "doctor": "node ./scripts/doctor.mjs",
    "qa:public-hubs": "pnpm --filter @crmanhung/shared build && node ./scripts/qa-public-listing-hubs.mjs",
    "qa:post-gpt": "pnpm --filter @crmanhung/shared build && node ./scripts/qa-post-gpt.mjs"
  }
}
